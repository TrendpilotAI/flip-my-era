# ─── BetterAuth (Authentication) ─────────────────────────────────────────────
# Required for the Netlify Function that handles /api/auth/* routes.

# A random secret string (32+ characters) used to sign session tokens.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change_me_generate_with_openssl_rand_base64_32

# The public base URL of your app (no trailing slash).
BETTER_AUTH_URL=http://localhost:8080

# Google OAuth (optional — enables "Sign in with Google").
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Postgres connection string (used by BetterAuth as its database).
# Use the *Transaction Pooler* or *Session Pooler* URL from Supabase dashboard
# (Settings → Database → Connection String → URI).
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ─── Stripe Configuration (Required) ─────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx  # For Supabase Edge Functions
STRIPE_WEBHOOK_SECRET=whsec_xxx  # For webhook signature verification

# Optional: Override default price IDs
VITE_STRIPE_PRICE_25_CREDITS=price_xxx
VITE_STRIPE_PRICE_55_CREDITS=price_xxx
VITE_STRIPE_PRICE_120_CREDITS=price_xxx
VITE_STRIPE_PRICE_STARTER=price_xxx
VITE_STRIPE_PRICE_DELUXE=price_xxx
VITE_STRIPE_PRICE_VIP=price_xxx

# ─── Supabase (Database + Edge Functions) ────────────────────────────────────
# NOTE: Supabase Auth is REPLACED by BetterAuth. Supabase is still used as the
# Postgres database for user profiles, credits, stories, etc.
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=xxx
# VITE_CLERK_PUBLISHABLE_KEY is no longer needed (Clerk was replaced by BetterAuth).
# GROQ_API_KEY and OPENAI_API_KEY are server-side only — set in Supabase Edge Function secrets
# DO NOT use VITE_ prefix for AI API keys — they would be exposed in client-side JS bundles
# Set via: supabase secrets set GROQ_API_KEY=gsk_xxx OPENAI_API_KEY=sk_xxx
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:8080

# ─── Runware ─────────────────────────────────────────────────────────────────
RUNWARE_API_KEY=xxx  # For Supabase Runware proxy (server-side)
VITE_RUNWARE_PROXY_URL=/api/functions/runware-proxy

# ─── SamCart ─────────────────────────────────────────────────────────────────
SAMCART_BASE_URL=https://checkout.samcart.com/products
VITE_SAMCART_CHECKOUT_ENDPOINT=/api/functions/samcart-checkout
